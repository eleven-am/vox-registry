{
  "architecture": "chatterbox-turbo",
  "type": "tts",
  "description": "Resemble Chatterbox Turbo \u2014 fast neural TTS with voice cloning",
  "license": "MIT",
  "parameters": {
    "sample_rate": 24000
  },
  "variants": [
    {
      "id": "torch",
      "aliases": [
        "cuda"
      ],
      "priority": 100,
      "source": "ResembleAI/chatterbox-turbo",
      "adapter": "chatterbox-tts-turbo",
      "format": "pytorch",
      "requires": {
        "python_modules": [
          "torch"
        ]
      },
      "adapter_package": "vox-chatterbox"
    },
    {
      "id": "onnx",
      "aliases": [
        "cpu"
      ],
      "priority": 0,
      "fallback": true,
      "source": "ResembleAI/chatterbox-turbo-ONNX",
      "adapter": "chatterbox-tts-turbo-onnx",
      "format": "onnx",
      "parameters": {
        "sample_rate": 24000,
        "onnx_dtype": "fp32"
      },
      "requires": {
        "python_modules": [
          "onnxruntime"
        ]
      },
      "files": [
        "config.json",
        "generation_config.json",
        "preprocessor_config.json",
        "tokenizer.json",
        "tokenizer_config.json",
        "onnx/conditional_decoder.onnx",
        "onnx/conditional_decoder.onnx_data",
        "onnx/embed_tokens.onnx",
        "onnx/embed_tokens.onnx_data",
        "onnx/language_model.onnx",
        "onnx/language_model.onnx_data",
        "onnx/speech_encoder.onnx",
        "onnx/speech_encoder.onnx_data"
      ],
      "adapter_package": "vox-chatterbox"
    }
  ]
}
